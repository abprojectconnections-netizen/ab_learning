# LOCAL — developer machine. `make env` copies this to backend/.env and fills
# each generated-secret placeholder with a random value. Never commit .env.
APP_ENV=dev
SEED_DEV=true

MYSQL_ROOT_PASSWORD=__GENERATE__
MYSQL_DATABASE=ab_learning
MYSQL_USER=ab_app
MYSQL_PASSWORD=__GENERATE__
MYSQL_HOST_PORT=3307

JWT_SECRET=__GENERATE_LONG__
CORS_ALLOW_ORIGIN=http://localhost:56901
API_HOST_PORT=8080

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

MINIO_ROOT_USER=__GENERATE__
MINIO_ROOT_PASSWORD=__GENERATE__
MINIO_BUCKET=ab-learning
# Override if your registry mirrors different tags:
# MINIO_IMAGE=minio/minio:latest
# MINIO_MC_IMAGE=minio/mc:latest

# Payments: SANDBOX / TEST MODE ONLY (used from Phase 4). Never put live keys here.
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=__GENERATE_LONG__
