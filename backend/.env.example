# Superseded by per-environment templates in backend/env/:
#   env/local.env.example       (LOCAL, used by `make env`)
#   env/test.env.example        (TEST / CI)
#   env/staging.env.example     (STAGING)
#   env/production.env.example  (PRODUCTION — not to be used until approved)
#
# For local development run:  make env   (creates backend/.env with random secrets)
