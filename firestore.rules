rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }

    function isInstructor() { return role() == 'instructor'; }
    function isAdmin() { return role() == 'admin' || role() == 'super_admin'; }
    function isSuperAdmin() { return role() == 'super_admin'; }
    function ownsCourse(courseId) {
      return signedIn()
        && get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == request.auth.uid;
    }
    function hasActiveEnrollment(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId))
        && get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'active';
    }

    // Organization membership docs are keyed {orgId}_{uid} so rules can look
    // up the caller's own membership without a query.
    function memberPath(orgId) {
      return /databases/$(database)/documents/org_members/$(orgId + '_' + request.auth.uid);
    }
    function isOrgMember(orgId) {
      return signedIn() && exists(memberPath(orgId)) && get(memberPath(orgId)).data.status == 'active';
    }
    function isOrgStaff(orgId) {
      return isOrgMember(orgId) && get(memberPath(orgId)).data.role in ['admin', 'manager'];
    }
    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && get(memberPath(orgId)).data.role == 'admin';
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'learner'
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt']);
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoUrl', 'bio', 'updatedAt']);
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == uid;
        // Created by Cloud Functions only; the owner may only mark as read.
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }

      match /progress/{lessonId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lessonId', 'courseId', 'completed', 'percentComplete', 'lastPositionSeconds', 'updatedAt'])
          && request.resource.data.courseId is string
          && hasActiveEnrollment(request.resource.data.courseId);
        allow delete: if false;
      }
    }

    match /instructor_applications/{applicationId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'experience', 'status', 'createdAt']);
      allow get, list: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']);
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if resource.data.status == 'published'
        || (signedIn() && request.auth.uid == resource.data.instructorId) || isAdmin();
      allow create: if isInstructor()
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.status == 'draft'
          && request.resource.data.keys().hasOnly(['title', 'description', 'price', 'categoryId', 'instructorId', 'instructorName', 'thumbnailUrl', 'status', 'createdAt', 'updatedAt']);
      allow update: if (ownsCourse(courseId)
          && resource.data.status in ['draft', 'rejected']
          && request.resource.data.instructorId == resource.data.instructorId
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'price', 'categoryId', 'thumbnailUrl', 'updatedAt']))
        || (ownsCourse(courseId)
          && resource.data.status == 'draft'
          && request.resource.data.status == 'pending_review'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'updatedAt'])
          && request.resource.data.status in ['published', 'rejected', 'archived']);
      allow delete: if false;

      match /sections/{sectionId} {
        allow read: if get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
          || ownsCourse(courseId) || isAdmin();
        allow create, update: if ownsCourse(courseId)
          && get(/databases/$(database)/documents/courses/$(courseId)).data.status in ['draft', 'rejected']
          && request.resource.data.keys().hasOnly(['title', 'order', 'createdAt']);
        allow delete: if false;
      }

      match /lessons/{lessonId} {
        allow read: if isAdmin() || ownsCourse(courseId)
          || (get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
            && (resource.data.isPreview == true || hasActiveEnrollment(courseId)));
        allow create, update: if ownsCourse(courseId)
          && get(/databases/$(database)/documents/courses/$(courseId)).data.status in ['draft', 'rejected']
          && request.resource.data.keys().hasOnly(['sectionId', 'title', 'durationSeconds', 'order', 'isPreview', 'videoRef', 'videoProvider', 'videoReference']);
        allow delete: if false;
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if (signedIn() && resource.data.studentId == request.auth.uid)
        || isAdmin();
      // Client-side enrollment can unlock free courses only. Paid enrollment
      // activation must be issued by a trusted server after verified payment.
      allow create: if signedIn()
        && enrollmentId == request.auth.uid + '_' + request.resource.data.courseId
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'active'
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.status == 'published'
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.price == 0
        && request.resource.data.keys().hasOnly(['studentId', 'courseId', 'status', 'enrolledAt']);
      allow update, delete: if false;
    }

    match /payment_mock/{transactionId} {
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;
      // The client may create a pending demo transaction; terminal states are
      // never client writable and this collection must not grant course access.
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['studentId', 'courseId', 'amount', 'currency', 'status', 'createdAt']);
      allow update, delete: if false;
    }

    match /course_reviews/{reviewId} {
      allow read: if true;
      // One review per learner per course; name must match the profile.
      allow create: if signedIn()
        && reviewId == request.auth.uid + '_' + request.resource.data.courseId
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && hasActiveEnrollment(request.resource.data.courseId)
        && request.resource.data.keys().hasOnly(['studentId', 'studentName', 'courseId', 'rating', 'comment', 'createdAt']);
      allow update, delete: if false;
    }

    // Quiz questions never contain answers. Answer keys live in quiz_answers,
    // which no client can read; grading happens in the submitQuiz function.
    match /quizzes/{quizId} {
      allow read: if signedIn()
        && (hasActiveEnrollment(resource.data.courseId) || ownsCourse(resource.data.courseId) || isAdmin());
      allow write: if false;
    }

    match /quiz_answers/{quizId} {
      allow read, write: if false;
    }

    match /quiz_attempts/{attemptId} {
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;
      allow write: if false;
    }

    match /certificates/{certificateId} {
      allow read: if signedIn() && resource.data.studentId == request.auth.uid;
      allow write: if false;
    }

    // Public verification by exact code only; the collection cannot be listed.
    match /certificate_verifications/{code} {
      allow get: if true;
      allow list, write: if false;
    }

    match /sales/{saleId} {
      allow read: if signedIn() && (resource.data.instructorId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /payouts/{payoutId} {
      allow read: if signedIn() && (resource.data.instructorId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // platform_config (revenue share, minimum payout) is server-only.

    // ---- Corporate learning ------------------------------------------------
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId) || isAdmin();
      allow write: if false; // created by the createOrganization function
    }

    match /org_members/{memberId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isOrgStaff(resource.data.orgId) || isAdmin());
      // Admins of the organization may suspend/reactivate members only.
      allow update: if isOrgAdmin(resource.data.orgId)
        && resource.data.role != 'admin'
        && request.resource.data.status in ['active', 'suspended']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow create, delete: if false; // addOrgMember function
    }

    match /learning_paths/{pathId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow create: if isOrgAdmin(request.resource.data.orgId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ['draft', 'active']
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.keys().hasOnly(['orgId', 'title', 'description', 'status', 'createdBy', 'createdAt']);
      allow update: if isOrgAdmin(resource.data.orgId)
        && request.resource.data.status in ['draft', 'active', 'archived']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'status', 'updatedAt']);
      allow delete: if false;
    }

    // ---- Recruitment -------------------------------------------------------
    match /job_postings/{jobId} {
      allow read: if resource.data.status == 'open'
        || (signedIn() && resource.data.employerId == request.auth.uid) || isAdmin();
      allow create: if role() == 'employer'
        && request.resource.data.employerId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.keys().hasOnly(['employerId', 'title', 'location', 'status', 'createdAt']);
      allow update: if role() == 'employer' && resource.data.employerId == request.auth.uid
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'location', 'status', 'updatedAt']);
      allow delete: if false;
    }

    match /job_applications/{applicationId} {
      allow read: if signedIn()
        && (resource.data.candidateId == request.auth.uid || resource.data.employerId == request.auth.uid);
      // A learner applies to an open posting; the employer is copied from the
      // posting and the display name must match the applicant's profile.
      allow create: if signedIn()
        && applicationId == request.resource.data.jobId + '_' + request.auth.uid
        && request.resource.data.candidateId == request.auth.uid
        && request.resource.data.status == 'new'
        && get(/databases/$(database)/documents/job_postings/$(request.resource.data.jobId)).data.status == 'open'
        && request.resource.data.employerId == get(/databases/$(database)/documents/job_postings/$(request.resource.data.jobId)).data.employerId
        && request.resource.data.candidateName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.keys().hasOnly(['jobId', 'employerId', 'candidateId', 'candidateName', 'status', 'createdAt']);
      allow update: if role() == 'employer' && resource.data.employerId == request.auth.uid
        && request.resource.data.status in ['screened', 'interview', 'offer', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // All unspecified collections and operations are denied by default.
  }
}
