# TEST — automated tests / CI. Throw-away database, demo seed allowed.
# CI injects these values itself; this file documents them.
APP_ENV=test
SEED_DEV=true
DB_DSN=ab_test:CHANGE_ME@tcp(127.0.0.1:3306)/ab_test?parseTime=true&charset=utf8mb4&loc=UTC
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
CORS_ALLOW_ORIGIN=http://localhost:3000
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_DIR=./uploads-test
PAYMENT_MODE=sandbox
