# PRODUCTION — DO NOT USE until production deployment is explicitly approved.
# Fill values in the hosting provider's secret store, never in Git.
# Never point LOCAL, TEST or STAGING at this database.
APP_ENV=production
SEED_DEV=false
DB_DSN=
JWT_SECRET=
CORS_ALLOW_ORIGIN=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_DIR=/data/uploads
# Stays "sandbox" until live payments are explicitly authorized in writing.
PAYMENT_MODE=sandbox
