# STAGING — production-like, separate database and secrets from production.
# Enforced by the API at startup: JWT_SECRET >= 32 chars, explicit HTTPS CORS
# origin, SEED_DEV=false. Fill values in the hosting provider's secret store,
# not in Git.
APP_ENV=staging
SEED_DEV=false
DB_DSN=
JWT_SECRET=
CORS_ALLOW_ORIGIN=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_DIR=/data/uploads
# Staging must stay in sandbox: no real charges.
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=
